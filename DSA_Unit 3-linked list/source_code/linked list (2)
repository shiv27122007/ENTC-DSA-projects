#include <iostream>
#include <string>
#include <limits>
#include <iomanip>
using namespace std;

struct Patient
{
    int token, age;
    string name, department, status;

    // Doubly linked list pointers
    Patient *prevRecord, *nextRecord;

    // FIFO queue pointer
    Patient *nextQueue;
};

Patient *head = NULL, *tail = NULL;
Patient *front = NULL, *rear = NULL;
int nextToken = 1001;

// Read integer safely
int readInt(string message)
{
    int value;

    while (true)
    {
        cout << message;

        if (cin >> value)
        {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return value;
        }

        cout << "Invalid input! Enter a number.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }
}

// Read text
string readText(string message)
{
    string value;

    do
    {
        cout << message;
        getline(cin, value);

        if (value.empty())
            cout << "Input cannot be empty!\n";

    } while (value.empty());

    return value;
}

// Select hospital department
string selectDepartment()
{
    int choice;

    cout << "\n------ HOSPITAL DEPARTMENTS ------\n";
    cout << "1. General Medicine\n";
    cout << "2. Cardiology\n";
    cout << "3. Orthopedics\n";
    cout << "4. Pediatrics\n";
    cout << "5. Emergency\n";

    while (true)
    {
        choice = readInt("Select department (1-5): ");

        switch (choice)
        {
            case 1: return "General Medicine";
            case 2: return "Cardiology";
            case 3: return "Orthopedics";
            case 4: return "Pediatrics";
            case 5: return "Emergency";

            default:
                cout << "Invalid choice! Select 1-5.\n";
        }
    }
}

// Count waiting patients
int countWaiting()
{
    int count = 0;
    Patient *p = front;

    while (p != NULL)
    {
        count++;
        p = p->nextQueue;
    }

    return count;
}

// Register patient
void registerPatient()
{
    Patient *p = new Patient{};

    p->token = nextToken++;
    p->name = readText("Enter patient name: ");

    do
    {
        p->age = readInt("Enter age (0-120): ");

        if (p->age < 0 || p->age > 120)
            cout << "Enter a valid age.\n";

    } while (p->age < 0 || p->age > 120);

    p->department = selectDepartment();
    p->status = "Waiting";

    // Insert into doubly linked list
    p->prevRecord = tail;
    p->nextRecord = NULL;

    if (head == NULL)
        head = p;
    else
        tail->nextRecord = p;

    tail = p;

    // Insert into FIFO queue
    p->nextQueue = NULL;

    if (front == NULL)
        front = rear = p;
    else
    {
        rear->nextQueue = p;
        rear = p;
    }

    int position = countWaiting();

    cout << "\nPatient Registered Successfully!\n";
    cout << "Token Number : " << p->token << '\n';
    cout << "Department   : " << p->department << '\n';
    cout << "Queue Position: " << position << '\n';
    cout << "Estimated Wait: "
         << (position - 1) * 10 << " minutes\n";
}

// Call next patient
void callNextPatient()
{
    if (front == NULL)
    {
        cout << "No patients are waiting.\n";
        return;
    }

    Patient *p = front;
    front = front->nextQueue;

    if (front == NULL)
        rear = NULL;

    p->nextQueue = NULL;
    p->status = "Served";

    cout << "\n========== PATIENT CALLED ==========\n";
    cout << "Token      : " << p->token << '\n';
    cout << "Name       : " << p->name << '\n';
    cout << "Department : " << p->department << '\n';
    cout << "Status     : " << p->status << '\n';
}

// Search patient by token
Patient* findPatient(int token)
{
    Patient *p = head;

    while (p != NULL)
    {
        if (p->token == token)
            return p;

        p = p->nextRecord;
    }

    return NULL;
}

// Search patient details
void searchPatient()
{
    int token = readInt("Enter patient token: ");
    Patient *p = findPatient(token);

    if (p == NULL)
    {
        cout << "Patient not found!\n";
        return;
    }

    cout << "\n------ PATIENT DETAILS ------\n";
    cout << "Token      : " << p->token << '\n';
    cout << "Name       : " << p->name << '\n';
    cout << "Age        : " << p->age << '\n';
    cout << "Department : " << p->department << '\n';
    cout << "Status     : " << p->status << '\n';
}

// Discharge patient
void dischargePatient()
{
    int token = readInt("Enter patient token for discharge: ");
    Patient *p = findPatient(token);

    if (p == NULL)
    {
        cout << "Patient not found!\n";
        return;
    }

    if (p->status == "Waiting")
    {
        cout << "Discharge denied: patient is still waiting.\n";
        cout << "Call the patient first.\n";
        return;
    }

    if (p->status == "Discharged")
    {
        cout << "This patient has already been discharged.\n";
        return;
    }

    p->status = "Discharged";

    cout << "\n====================================\n";
    cout << "      PATIENT DISCHARGED\n";
    cout << "====================================\n";
    cout << "Token      : " << p->token << '\n';
    cout << "Name       : " << p->name << '\n';
    cout << "Department : " << p->department << '\n';
    cout << "Status     : " << p->status << '\n';
    cout << "Discharge completed successfully!\n";
}

// Display records in forward order
void displayForward()
{
    if (head == NULL)
    {
        cout << "No patient records available.\n";
        return;
    }

    Patient *p = head;

    cout << "\n================ PATIENT RECORDS ================\n";

    cout << left
         << setw(10) << "Token"
         << setw(22) << "Name"
         << setw(20) << "Department"
         << setw(8) << "Age"
         << "Status\n";

    cout << string(75, '-') << '\n';

    while (p != NULL)
    {
        cout << left
             << setw(10) << p->token
             << setw(22) << p->name
             << setw(20) << p->department
             << setw(8) << p->age
             << p->status << '\n';

        p = p->nextRecord;
    }
}

// Display records in reverse order
void displayReverse()
{
    if (tail == NULL)
    {
        cout << "No patient records available.\n";
        return;
    }

    Patient *p = tail;

    cout << "\n======= PATIENT RECORDS: REVERSE ORDER =======\n";

    while (p != NULL)
    {
        cout << "Token: " << p->token
             << " | Name: " << p->name
             << " | Department: " << p->department
             << " | Status: " << p->status << '\n';

        p = p->prevRecord;
    }
}

// Hospital dashboard
void hospitalDashboard()
{
    int total = 0, waiting = 0;
    int consulted = 0, discharged = 0;

    Patient *p = head;

    while (p != NULL)
    {
        total++;

        if (p->status == "Waiting")
            waiting++;

        if (p->status == "Served" ||
            p->status == "Discharged")
            consulted++;

        if (p->status == "Discharged")
            discharged++;

        p = p->nextRecord;
    }

    cout << "\n========== HOSPITAL DASHBOARD ==========\n";
    cout << "Total Registered : " << total << '\n';
    cout << "Patients Waiting : " << waiting << '\n';
    cout << "Patients Consulted: " << consulted << '\n';
    cout << "Patients Discharged: " << discharged << '\n';
    cout << "Estimated Wait   : " << waiting * 10
         << " minutes\n";
    cout << "========================================\n";
}

// Main function
int main()
{
    int choice;

    do
    {
        cout << "\n========================================\n";
        cout << "    SMART HOSPITAL MANAGEMENT SYSTEM\n";
        cout << "========================================\n";
        cout << "1. Register Patient\n";
        cout << "2. Call Next Patient\n";
        cout << "3. Search Patient\n";
        cout << "4. Display All Records\n";
        cout << "5. Display Records in Reverse\n";
        cout << "6. Count Waiting Patients\n";
        cout << "7. Hospital Dashboard\n";
        cout << "8. Discharge Patient\n";
        cout << "0. Exit\n";
        cout << "========================================\n";

        choice = readInt("Enter your choice: ");

        switch (choice)
        {
            case 1:
                registerPatient();
                break;

            case 2:
                callNextPatient();
                break;

            case 3:
                searchPatient();
                break;

            case 4:
                displayForward();
                break;

            case 5:
                displayReverse();
                break;

            case 6:
                cout << "Patients waiting: "
                     << countWaiting() << '\n';
                break;

            case 7:
                hospitalDashboard();
                break;

            case 8:
                dischargePatient();
                break;

            case 0:
                cout << "Hospital system closed successfully.\n";
                break;

            default:
                cout << "Invalid choice! Try again.\n";
        }

    } while (choice != 0);

    // Free dynamically allocated memory
    while (head != NULL)
    {
        Patient *temp = head;
        head = head->nextRecord;
        delete temp;
    }

    return 0;
}
